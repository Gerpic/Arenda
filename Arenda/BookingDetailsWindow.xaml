<Window x:Class="Arenda.Windows.BookingDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Детали бронирования"
        Width="750"
        Height="700"
        WindowStartupLocation="CenterScreen"
        Background="#F9FAFB">
    <Window.Resources>
        <Geometry x:Key="ChatIconGeometry">M12,2A10,10 0 0,0 2,12C2,16.42 5.58,20 10,20C11.38,20 12.68,19.74 13.82,19.27L18,20L16.73,15.82C17.74,14.68 18.23,13.22 18.23,11.65C18.23,7.23 14.65,2 10,2M12,14H8V12H12V14M14,10H8V8H14V10Z</Geometry>
        <SolidColorBrush x:Key="AccentBrush" Color="#1E90FF"/>
        <Style x:Key="AccentOutlinedButton" TargetType="Button">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#1E90FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1E90FF"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BackButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="90"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#1E90FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1E90FF"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Border Background="White" CornerRadius="10" Padding="20" Margin="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Кнопка назад -->
                    <Button Content="← Назад"
                            Style="{StaticResource BackButtonStyle}"
                            Click="BackButton_Click"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,10"/>
                    <TextBlock Text="Детали бронирования" FontSize="20" FontWeight="Bold" Foreground="#1E90FF" Margin="0,0,0,15"/>

                    <!-- Информация о недвижимости -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Недвижимость: " FontWeight="Bold"/>
                        <TextBlock Text="{Binding Property.Address}" Margin="5,0"/>
                        <TextBlock Text="(" Foreground="Gray"/>
                        <TextBlock Text="{Binding Property.Category.CategoryName}" Foreground="Gray"/>
                        <TextBlock Text=")" Foreground="Gray"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Город: " FontWeight="Bold"/>
                        <TextBlock Text="{Binding Property.City.Name}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Площадь: " FontWeight="Bold"/>
                        <TextBlock Text="{Binding Property.Area}" />
                        <TextBlock Text=" м²" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Цена: " FontWeight="Bold"/>
                        <TextBlock Text="{Binding Property.Price}" />
                        <TextBlock Text=" ₽" />
                    </StackPanel>
                    <Separator Margin="0,10"/>

                    <!-- Информация о периоде бронирования -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Период: " FontWeight="Bold"/>
                        <TextBlock Text="{Binding StartDate, StringFormat='{}{0:dd.MM.yyyy}'}"/>
                        <TextBlock Text=" — " />
                        <TextBlock Text="{Binding EndDate, StringFormat='{}{0:dd.MM.yyyy}'}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Дата бронирования: " FontWeight="Bold" />
                        <TextBlock Text="{Binding BookingDate, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Статус: " FontWeight="Bold"/>
                        <TextBlock Text="{Binding Status}" x:Name="StatusTextBlock"/>
                    </StackPanel>
                    <Separator Margin="0,10"/>

                    <!-- Информация о пользователе и владельце с кнопками чата -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                        <TextBlock Text="Пользователь: " FontWeight="Bold"/>
                        <TextBlock Text="{Binding User.FullName}" />
                        <TextBlock Text="  " />
                        <Button Width="40" Height="40"
                                Margin="10,0"
                                Click="UserChatButton_Click"
                                ToolTip="Чат с пользователем"
                                Background="{StaticResource AccentBrush}"
                                BorderThickness="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="20"
                                            Width="40" Height="40"
                                            VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Grid Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Viewbox Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path Data="{StaticResource ChatIconGeometry}" Fill="White" Stretch="Uniform"/>
                                            </Viewbox>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                        <TextBlock Text="Владелец: " FontWeight="Bold"/>
                        <TextBlock Text="{Binding Property.Owner.FullName}" />
                        <TextBlock Text="  " />
                        <Button Width="40" Height="40"
                                Margin="10,0"
                                Click="OwnerChatButton_Click"
                                ToolTip="Чат с владельцем"
                                Background="{StaticResource AccentBrush}"
                                BorderThickness="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="20"
                                            Width="40" Height="40"
                                            VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Grid Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Viewbox Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path Data="{StaticResource ChatIconGeometry}" Fill="White" Stretch="Uniform"/>
                                            </Viewbox>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <Separator Margin="0,10"/>

                    <!-- Действия с бронированием -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                        <Button x:Name="AcceptButton"
                                Content="Принять"
                                Style="{StaticResource AccentOutlinedButton}"
                                Click="AcceptButton_Click"/>
                        <Button x:Name="RejectButton"
                                Content="Отклонить"
                                Style="{StaticResource AccentOutlinedButton}"
                                Margin="0"
                                Click="RejectButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>