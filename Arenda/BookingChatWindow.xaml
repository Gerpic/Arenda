<Window x:Class="Arenda.Windows.BookingChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чат по бронированию"
        Width="600"
        Height="700"
        WindowStartupLocation="CenterScreen"
        Background="#F9FAFB">
    <Grid>
        <Border Background="White" CornerRadius="10" Padding="15" Margin="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Button Content="← Назад"
                            Width="90"
                            Height="32"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Click="BackButton_Click"
                            Background="#F1F5F9"
                            Foreground="#1E90FF"
                            BorderThickness="1"
                            BorderBrush="#1E90FF"
                            FontWeight="Bold"
                            FontSize="13">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="7"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="2">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBlock Text="Чат по бронированию"
                               FontWeight="Bold"
                               FontSize="18"
                               Foreground="#1E90FF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Grid.Row="1"
                           Text="{Binding InterlocutorName}"
                           FontWeight="Bold"
                           FontSize="15"
                           Foreground="#6C60FF"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,4"/>

                <ScrollViewer x:Name="ChatScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" Background="Transparent">
                    <ItemsControl x:Name="MessagesPanel" ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,6">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOwn}" Value="True">
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Border CornerRadius="18"
                                            Padding="10,7"
                                            MaxWidth="420"
                                            Background="{Binding BubbleColor}">
                                        <TextBlock Text="{Binding Content}" Foreground="#222" TextWrapping="Wrap"/>
                                    </Border>
                                    <TextBlock Text="{Binding Time, StringFormat='{}{0:HH:mm}'}"
                                               Foreground="#B7A4FF"
                                               FontSize="11"
                                               HorizontalAlignment="Right"
                                               Margin="0,2,4,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="MessageTextBox"
                             Height="36"
                             Background="#F1F1F1"
                             BorderBrush="#E0E0E0"
                             BorderThickness="1"
                             Padding="8,0"
                             FontSize="14"
                             Foreground="#222"
                             VerticalContentAlignment="Center"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Center"
                             Grid.Column="0"
                             MaxWidth="420"/>
                    <Button Width="46"
                            Height="36"
                            Background="#1E90FF"
                            BorderThickness="0"
                            Margin="10,0,0,0"
                            Click="SendMessageButton_Click"
                            Grid.Column="1"
                            ToolTip="Отправить"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Padding="0"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="18"
                                        Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Path Data="M2,21L23,12L2,3V10L17,12L2,14V21Z"
                              Fill="White"
                              Width="26"
                              Height="26"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>