<Window x:Class="Arenda.Windows.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Arenda.Converters"
        Title="Чаты"
        WindowStartupLocation="CenterScreen"
        Width="1140" Height="700"
        Background="#23232A"
        ResizeMode="CanResize">
    <Window.Resources>
        <!-- Цвета -->
        <SolidColorBrush x:Key="LeftPanelBrush" Color="#181820"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#8A7FFF"/>
        <SolidColorBrush x:Key="InputBrush" Color="#23232A"/>
        <SolidColorBrush x:Key="SendBrush" Color="#8A7FFF"/>
        <!-- Иконки -->
        <Geometry x:Key="SendIcon">M2,21L23,12L2,3V10L17,12L2,14V21Z</Geometry>
        <Geometry x:Key="AttachIcon">M18.364,5.636c2.343,2.343,2.343,6.142,0,8.485l-7.071,7.071c-2.343,2.343-6.142,2.343-8.485,0s-2.343-6.142,0-8.485l7.071-7.071c1.562-1.562,4.095-1.562,5.657,0s1.562,4.095,0,5.657l-7.071,7.071</Geometry>
        <Geometry x:Key="MicIcon">M12 14a2 2 0 0 0 2-2V6a2 2 0 1 0-4 0v6a2 2 0 0 0 2 2zm5-2a1 1 0 1 1 2 0c0 3.31-2.69 6-6 6s-6-2.69-6-6a1 1 0 1 1 2 0c0 2.21 1.79 4 4 4s4-1.79 4-4z</Geometry>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель: список чатов -->
        <Border Grid.Column="0" Background="{StaticResource LeftPanelBrush}">
            <DockPanel LastChildFill="True">
                <!-- Верхняя панель поиска -->
                <StackPanel Orientation="Horizontal" Background="#23232A" Height="55" VerticalAlignment="Top">
                    <TextBox x:Name="SearchBox" Width="220" Height="34" Margin="16,10,0,10" Padding="10,2"
                             VerticalAlignment="Center"
                             FontSize="16" Foreground="White" Background="#292936"
                             PlaceholderText="Search" BorderThickness="0"
                             />
                    <Button Width="34" Height="34" Margin="10,10,0,10" Background="#292936" BorderThickness="0">
                        <Viewbox Width="18" Height="18">
                            <Path Data="M15.5,14h-.79l-.28-.27c.98-1.14,1.57-2.61,1.57-4.23C16,5.01,12.99,2,9.5,2S3,5.01,3,8.5
                                6.01,15,9.5,15c1.61,0,3.09-.59,4.23-1.57l.27.28v.79l5,4.99
                                L20.49,19l-4.99-5zm-6,0C6.01,14,4,11.99,4,9.5S6.01,5,9.5,5
                                15,7.01,15,9.5 12.99,14,9.5,14z"
                                  Fill="#8A7FFF"/>
                        </Viewbox>
                    </Button>
                </StackPanel>
                <!-- Список чатов -->
                <ListBox x:Name="ChatsListBox" DockPanel.Dock="Top" 
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="White"
                         ItemTemplate="{StaticResource ChatListItemTemplate}"
                         SelectionChanged="ChatsListBox_SelectionChanged"
                         >
                    <ListBox.Resources>
                        <!-- Стиль для выделенного чата -->
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="10"
                                                Margin="2,0,2,5">
                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#2F2743"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <!-- DataTemplate для чата -->
                        <DataTemplate x:Key="ChatListItemTemplate">
                            <Grid Margin="10,5,10,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" CornerRadius="22" Background="#282840" VerticalAlignment="Center">
                                    <Image Source="{Binding Avatar}" Width="44" Height="44" Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="15" Foreground="White"/>
                                    <TextBlock Text="{Binding LastMessage}" FontSize="13" Foreground="#CFC5EA" TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding LastMessageDate}" FontSize="12" Foreground="#B7A4FF" HorizontalAlignment="Right"/>
                                    <Border Width="22" Height="22" Background="#8A7FFF" CornerRadius="11"
                                            Visibility="{Binding UnreadCount, Converter={StaticResource UnreadToVisibilityConverter}}">
                                        <TextBlock Text="{Binding UnreadCount}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                        <!-- Конвертер для непрочитанных сообщений -->
                        <converters:UnreadToVisibilityConverter x:Key="UnreadToVisibilityConverter"/>
                    </ListBox.Resources>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Правая панель: сам чат -->
        <Border Grid.Column="1" Background="#181820">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="70"/>
                </Grid.RowDefinitions>
                <!-- Заголовок чата -->
                <StackPanel Orientation="Horizontal" Grid.Row="0" Background="#23232A" Height="60">
                    <Border Width="44" Height="44" CornerRadius="22" Background="#282840" VerticalAlignment="Center" Margin="24,0,0,0">
                        <Image Source="{Binding SelectedChat.Avatar}" Width="44" Height="44" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Text="{Binding SelectedChat.DisplayName}" VerticalAlignment="Center" Margin="14,0,0,0"
                               Foreground="White" FontWeight="Bold" FontSize="18"/>
                    <!-- Можно добавить пометку "Владелец" или "Пользователь" -->
                    <TextBlock Text="{Binding SelectedChat.RoleLabel}" Foreground="#8A7FFF" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="10,0,0,0" FontSize="15"
                               Visibility="{Binding SelectedChat.RoleLabel, Converter={StaticResource StringToVisibilityConverter}}"/>
                </StackPanel>
                <!-- Сообщения чата -->
                <ScrollViewer Grid.Row="1" Background="Transparent" VerticalScrollBarVisibility="Auto" Name="ScrollViewer">
                    <ItemsControl x:Name="MessagesItemsControl" ItemsSource="{Binding SelectedChat.Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel HorizontalAlignment="{Binding IsOwn, Converter={StaticResource BoolToAlignmentConverter}}" Margin="0,5">
                                    <Border Background="{Binding IsOwn, Converter={StaticResource MessageBubbleBrushConverter}}"
                                            CornerRadius="13"
                                            Padding="10,7" MaxWidth="450"
                                            HorizontalAlignment="{Binding IsOwn, Converter={StaticResource BoolToAlignmentConverter}}">
                                        <TextBlock Text="{Binding Content}" Foreground="White" TextWrapping="Wrap"/>
                                    </Border>
                                    <TextBlock Text="{Binding Time, StringFormat='{}{0:HH:mm}'}"
                                               Foreground="#B7A4FF" FontSize="11"
                                               HorizontalAlignment="{Binding IsOwn, Converter={StaticResource BoolToAlignmentConverter}}"
                                               Margin="6,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <!-- Ввод сообщения -->
                <Grid Grid.Row="2" Background="#23232A" Height="70">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="48"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Margin="20,15,10,15" Background="#292936" CornerRadius="10" Height="40" VerticalAlignment="Center">
                        <TextBox x:Name="MessageTextBox" Margin="10,0,0,0"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="White" FontSize="15"
                                 VerticalContentAlignment="Center"
                                 Height="40"
                                 PlaceholderText="Message"/>
                    </Border>
                    <Button Grid.Column="1" Width="40" Height="40" Margin="4,15,4,15"
                            Background="Transparent" BorderThickness="0"
                            ToolTip="Прикрепить файл">
                        <Viewbox Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="{StaticResource AttachIcon}" Fill="#8A7FFF"/>
                        </Viewbox>
                    </Button>
                    <Button Grid.Column="2" Width="40" Height="40" Margin="4,15,20,15"
                            Background="{StaticResource SendBrush}" BorderThickness="0"
                            ToolTip="Отправить"
                            Click="SendMessageButton_Click">
                        <Viewbox Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="{StaticResource SendIcon}" Fill="White"/>
                        </Viewbox>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>