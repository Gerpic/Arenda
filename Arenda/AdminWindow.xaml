<Window x:Class="Arenda.Windows.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Панель администратора"
        Width="1000"
        Height="700"
        WindowStartupLocation="CenterScreen"
        Background="#F9FAFB">
    <Grid>
        <Border Background="White" CornerRadius="10" Padding="15" Margin="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- Верхняя панель с кнопкой выхода и заголовком -->
                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Кнопка выхода -->
                    <Button Content="Выйти"
                            Width="90"
                            Height="35"
                            Margin="0,0,10,0"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Click="Logout_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#FFFFFF"
                                        CornerRadius="10"
                                        BorderBrush="#FF2D2D"
                                        BorderThickness="1"
                                        Padding="5">
                                    <TextBlock Text="{TemplateBinding Content}"
                                               Foreground="#FF2D2D"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="14"
                                               FontWeight="Bold" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBlock Text="Объявления"
                               Grid.Column="1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#1E90FF" />
                    <Button Content="Чат поддержки"
                            Width="160"
                            Height="35"
                            Margin="5"
                            Grid.Column="2"
                            Click="SupportChat_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#FFFFFF"
                                        CornerRadius="10"
                                        BorderBrush="#1E90FF"
                                        BorderThickness="1"
                                        Padding="5">
                                    <TextBlock Text="{TemplateBinding Content}"
                                               Foreground="#1E90FF"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="14"
                                               FontWeight="Bold" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
                <ListView x:Name="PropertiesListView"
                          Grid.Row="1"
                          Margin="10"
                          MouseDoubleClick="PropertiesListView_MouseDoubleClick"
                          VerticalAlignment="Stretch"
                          HorizontalAlignment="Stretch">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel VerticalAlignment="Stretch"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FFFFFF" Margin="5" Padding="10" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Category}" FontWeight="Bold" FontSize="14" />
                                        <TextBlock Text="{Binding Address}" FontSize="12" Foreground="Gray" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding City}" FontSize="12" />
                                        <TextBlock Text="Владелец: " FontSize="12" Foreground="Gray" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding OwnerName}" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="Площадь:" FontSize="12" />
                                        <TextBlock Text="{Binding Area}" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock Text="Цена:" FontSize="12" Margin="0,8,0,0"/>
                                        <TextBlock Text="{Binding Price}" FontWeight="Bold" FontSize="13" Foreground="#1E90FF"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="ID:" FontSize="12" />
                                        <TextBlock Text="{Binding Id}" FontWeight="Bold" FontSize="13"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Window>