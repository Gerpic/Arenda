<Window x:Class="Arenda.Windows.EditPropertyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование объявления"
        Width="620"
        Height="780"
        WindowStartupLocation="CenterOwner"
        Background="#F9FAFB">
    <Grid>
        <Border Background="White" CornerRadius="10" Padding="20" Margin="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Кнопка назад -->
                    <Button Content="← Назад"
                            Width="95"
                            Height="32"
                            Margin="0,0,0,10"
                            HorizontalAlignment="Left"
                            Click="BackButton_Click"
                            Background="#F1F5F9"
                            Foreground="#1E90FF"
                            BorderThickness="1"
                            BorderBrush="#1E90FF"
                            FontWeight="Bold"
                            FontSize="13">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="7"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="2">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <TextBlock Text="Редактирование объявления"
                               FontWeight="Bold"
                               FontSize="18"
                               HorizontalAlignment="Center"
                               Foreground="#1E90FF"
                               Margin="0,0,0,14"/>

                    <TextBlock Text="Владелец:" FontWeight="Bold" Margin="0,6,0,2"/>
                    <TextBox x:Name="OwnerBox" Width="300" Margin="0,0,0,6" IsReadOnly="True" Background="#F1F5F9" BorderThickness="1" BorderBrush="#D1D5DB" />

                    <TextBlock Text="Город:" FontWeight="Bold" Margin="0,6,0,2"/>
                    <ComboBox x:Name="CityBox" DisplayMemberPath="Name" Width="300" Margin="0,0,0,6"/>

                    <TextBlock Text="Категория:" FontWeight="Bold" Margin="0,6,0,2"/>
                    <ComboBox x:Name="CategoryBox" DisplayMemberPath="CategoryName" Width="300" Margin="0,0,0,6"/>

                    <TextBlock Text="Адрес:" FontWeight="Bold" Margin="0,6,0,2"/>
                    <TextBox x:Name="AddressBox" Width="480" Margin="0,0,0,6"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="Площадь:" FontWeight="Bold" Margin="0,6,0,2"/>
                            <TextBox x:Name="AreaBox" Width="90"/>
                        </StackPanel>
                        <StackPanel Margin="30,0,0,0">
                            <TextBlock Text="Цена:" FontWeight="Bold" Margin="0,6,0,2"/>
                            <TextBox x:Name="PriceBox" Width="120"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Описание:" FontWeight="Bold" Margin="0,6,0,2"/>
                    <TextBox x:Name="DescriptionBox" Width="480" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,6"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="Комнат:" FontWeight="Bold" Margin="0,6,0,2"/>
                            <TextBox x:Name="RoomCountBox" Width="90"/>
                        </StackPanel>
                        <StackPanel Margin="30,0,0,0">
                            <TextBlock Text="Вместимость:" FontWeight="Bold" Margin="0,6,0,2"/>
                            <TextBox x:Name="CapacityBox" Width="90"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Блок отзывов -->
                    <Expander Header="Отзывы" Margin="0,18,0,0" IsExpanded="False">
                        <ItemsControl x:Name="ReviewsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="8">
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel Width="270">
                                                <TextBlock Text="{Binding User.FullName}" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Comment}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding ReviewDate, StringFormat='{}{0:dd.MM.yyyy}'}" FontSize="10" Foreground="Gray"/>
                                            </StackPanel>
                                            <Button Content="Удалить"
                                                    Background="#FF5964"
                                                    Foreground="White"
                                                    BorderThickness="0"
                                                    Width="140"
                                                    Height="44"
                                                    Margin="32,0,0,0"
                                                    FontSize="15"
                                                    ToolTip="Удалить отзыв"
                                                    Click="DeleteReview_Click"
                                                    Tag="{Binding Id}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                CornerRadius="4"
                                                                VerticalAlignment="Center"
                                                                HorizontalAlignment="Center"
                                                                Padding="10,2">
                                                            <TextBlock Text="{TemplateBinding Content}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="14"
                                                                       FontWeight="Bold"
                                                                       Foreground="White"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0" HorizontalAlignment="Right">
                        <Button Content="Сохранить"
                                Width="120"
                                Margin="0,0,10,0"
                                Click="Save_Click"
                                Height="35">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#FFFFFF"
                                            CornerRadius="10"
                                            BorderBrush="#1E90FF"
                                            BorderThickness="1"
                                            Padding="5">
                                        <TextBlock Text="{TemplateBinding Content}"
                                                   Foreground="#1E90FF"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="14"
                                                   FontWeight="Bold" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="Удалить объявление"
                                Width="172"
                                Margin="0,0,10,0"
                                Click="Delete_Click"
                                Height="35"
                                Background="#fff"
                                Foreground="#FF2D2D">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#fff"
                                            CornerRadius="10"
                                            BorderBrush="#FF2D2D"
                                            BorderThickness="1"
                                            Padding="5">
                                        <TextBlock Text="{TemplateBinding Content}"
                                                   Foreground="#FF2D2D"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="14"
                                                   FontWeight="Bold" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>