<Window x:Class="Arenda.Windows.SupportChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чат поддержки"
        Width="1200"
        Height="760"
        WindowStartupLocation="CenterScreen"
        Background="#F9FAFB">
    <Window.Resources>
        <!-- Стиль кнопки "Назад" -->
        <Style x:Key="BackButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#1E90FF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1E90FF"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Стиль для ListBoxItem в списке диалогов -->
        <Style x:Key="DialogListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="15"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                SnapsToDevicePixels="true">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1E90FF"/>
                                <Setter TargetName="Bd" Property="Background" Value="#ECF4FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Border Background="White" CornerRadius="18" Margin="10">
            <Grid Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="410"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Верхняя панель -->
                <Grid Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2">
                    <Button Content="← Назад"
                            Style="{StaticResource BackButtonStyle}"
                            Click="BackButton_Click"/>
                    <TextBlock Text="Чат поддержки"
                               FontWeight="Bold"
                               FontSize="24"
                               Foreground="#308CFF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>
                <!-- Список диалогов -->
                <Border Grid.Column="0" Grid.Row="1"
                        Background="#F6F8FA"
                        CornerRadius="18"
                        Margin="0,6,16,0"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Все диалоги"
                                   FontWeight="Bold"
                                   FontSize="22"
                                   Foreground="#1E90FF"
                                   Margin="20,18,0,18"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Height="600">
                            <ListBox x:Name="DialogList"
         ItemContainerStyle="{StaticResource DialogListItemStyle}"
         ItemsSource="{Binding Tickets}"
         SelectedItem="{Binding SelectedTicket, Mode=TwoWay}"
         SelectionChanged="DialogList_SelectionChanged"
         Background="Transparent"
         BorderThickness="0"
         FontSize="18">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent" Margin="8,0,8,0" CornerRadius="10">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8">
                                                <Ellipse Width="18" Height="18" Fill="#E2E5E7" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding UserFullName}"
                               FontWeight="SemiBold"
                               Foreground="#444"
                               VerticalAlignment="Center"
                               FontSize="18"/>
                                                <TextBlock Text=" (ID: " Foreground="#888" FontSize="16"/>
                                                <TextBlock Text="{Binding UserId}" Foreground="#888" FontSize="16"/>
                                                <TextBlock Text=")" Foreground="#888" FontSize="16"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
                <!-- Правая часть: чат -->
                <Grid Grid.Column="1" Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- Заголовок чата: ФИО и ID -->
                    <StackPanel Orientation="Horizontal" Height="58" VerticalAlignment="Top" Margin="0,0,0,8" Grid.Row="0">
                        <Ellipse Width="44" Height="44" Fill="#E0E0E0" Margin="0,0,14,0"/>
                        <TextBlock FontWeight="Bold"
                                   FontSize="22"
                                   Foreground="Black"
                                   Text="{Binding SelectedTicket.UserFullName}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text=" (ID: " Foreground="#888" FontSize="18" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedTicket.UserId}" Foreground="#888" FontSize="18" VerticalAlignment="Center"/>
                        <TextBlock Text=")" Foreground="#888" FontSize="18" VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- Сообщения -->
                    <ScrollViewer x:Name="MessagesScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="Transparent">
                        <ItemsControl x:Name="MessagesPanel" ItemsSource="{Binding CurrentMessages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,10">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFromSupport}" Value="True">
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Border CornerRadius="20"
                                                Margin="0,0,0,0"
                                                Padding="16,10"
                                                MaxWidth="520"
                                                Background="{Binding BubbleColor}">
                                            <TextBlock Text="{Binding Text}" Foreground="#222" TextWrapping="Wrap" FontSize="16"/>
                                        </Border>
                                        <TextBlock Text="{Binding Time, StringFormat='{}{0:HH:mm}'}"
                                                   Foreground="#C4A4FF"
                                                   FontSize="14"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,4,8,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <!-- Ввод сообщения -->
                    <Grid Grid.Row="2" Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="MessageTextBox"
                                 Height="44"
                                 Background="#F1F1F1"
                                 BorderBrush="#E0E0E0"
                                 BorderThickness="1"
                                 Padding="10,0"
                                 FontSize="16"
                                 Foreground="#222"
                                 VerticalContentAlignment="Center"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Center"
                                 Grid.Column="0"
                                 MaxWidth="900"/>
                        <Button Width="54"
                                Height="44"
                                Background="#1E90FF"
                                BorderThickness="0"
                                Margin="14,0,0,0"
                                Click="SendMessage_Click"
                                Grid.Column="1"
                                ToolTip="Отправить"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Padding="0"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Ellipse Fill="{TemplateBinding Background}"
                                                 Width="44"
                                                 Height="44"/>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </ControlTemplate>
                            </Button.Template>
                            <Path Data="M2,21L23,12L2,3V10L17,12L2,14V21Z"
                                  Fill="White"
                                  Width="26"
                                  Height="26"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>