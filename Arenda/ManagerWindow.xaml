<Window x:Class="Arenda.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Окно сотрудника"
        Width="1000"
        Height="700"
        WindowStartupLocation="CenterScreen"
        Background="#F9FAFB">
    <Grid>
        <Border Background="White" CornerRadius="10" Padding="15" Margin="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Верхняя панель -->
                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <!-- Кнопка выхода -->
                        <ColumnDefinition Width="*" />
                        <!-- Заголовок -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Заявления -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Чаты -->
                    </Grid.ColumnDefinitions>

                    <!-- Кнопка выхода (слева) -->
                    <Button Content="Выйти"
                            Width="90"
                            Height="35"
                            Margin="0,0,10,0"
                            Grid.Column="0"
                            Click="LogoutButton_Click"
                            Background="#fff"
                            Foreground="#FF2D2D">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#fff"
                                        CornerRadius="10"
                                        BorderBrush="#FF2D2D"
                                        BorderThickness="1"
                                        Padding="5">
                                    <TextBlock Text="{TemplateBinding Content}"
                                               Foreground="#FF2D2D"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="14"
                                               FontWeight="Bold" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <TextBlock Text="Бронирования"
                               Grid.Column="1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#1E90FF" />

                    <Button Content="Заявления на объявления"
                            Width="200"
                            Height="35"
                            Margin="5"
                            Grid.Column="2"
                            Click="OpenListingRequestsButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#FFFFFF"
                                        CornerRadius="10"
                                        BorderBrush="#1E90FF"
                                        BorderThickness="1"
                                        Padding="5">
                                    <TextBlock Text="{TemplateBinding Content}"
                                               Foreground="#1E90FF"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="14"
                                               FontWeight="Bold" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Content="Чаты"
                            Width="120"
                            Height="35"
                            Margin="5"
                            Grid.Column="3"
                            Click="OpenChatsButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#FFFFFF"
                                        CornerRadius="10"
                                        BorderBrush="#1E90FF"
                                        BorderThickness="1"
                                        Padding="5">
                                    <TextBlock Text="{TemplateBinding Content}"
                                               Foreground="#1E90FF"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="14"
                                               FontWeight="Bold" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Список броней -->
                <ListView x:Name="BookingsListView" Grid.Row="1" Margin="10" SelectionChanged="BookingsListView_SelectionChanged"
                          VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel VerticalAlignment="Stretch"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FFFFFF" Margin="5" Padding="10" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="230" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding PropertyCategory}" FontWeight="Bold" FontSize="14" />
                                        <TextBlock Text="{Binding PropertyAddress}" FontSize="12" Foreground="Gray" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding City}" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                        <TextBlock Text="Дата бронирования:" FontSize="12" />
                                        <TextBlock Text="{Binding BookingDate, StringFormat='{}{0:dd.MM.yyyy}'}" FontWeight="Bold" FontSize="13" Foreground="#1E90FF"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Window>