<Window x:Class="Arenda.BookingReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Отчет по бронированиям"
        Width="1000"
        Height="700"
        WindowStartupLocation="CenterScreen"
        Background="#F9FAFB">
    <Window.Resources>
        <!-- Классический стиль кнопки -->
        <Style x:Key="ClassicButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="130"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Background" Value="#fff"/>
            <Setter Property="BorderBrush" Value="#1E90FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1E90FF"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ExportButtonStyle" TargetType="Button" BasedOn="{StaticResource ClassicButtonStyle}">
            <Setter Property="Foreground" Value="#2D8C2D"/>
            <Setter Property="BorderBrush" Value="#2D8C2D"/>
        </Style>

        <!-- DatePicker с обводкой и закругленными углами, с возможностью ввода и выбора мышкой -->
        <Style x:Key="RoundedDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Width" Value="200"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#1E90FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#fff"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Grid>
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">
                                <Grid>
                                    <DatePickerTextBox x:Name="PART_TextBox"
                                                       IsReadOnly="False"
                                                       BorderThickness="0"
                                                       Background="Transparent"
                                                       FontSize="{TemplateBinding FontSize}"
                                                       Padding="8,2,36,2"/>
                                    <Button x:Name="PART_Button"
                                            Width="32"
                                            Height="32"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="0,0,2,0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Focusable="False"
                                            IsTabStop="False">
                                        <Path Data="M7,2V4H5A2,2 0 0,0 3,6V18A2,2 0 0,0 5,20H19A2,2 0 0,0 21,18V6A2,2 0 0,0 19,4H17V2H15V4H9V2M19,8V18H5V8H19Z"
                                              Fill="#1E90FF"
                                              Width="22" Height="22" Stretch="Uniform"/>
                                    </Button>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <Border Margin="0,2,0,0"
                                        CornerRadius="10"
                                        BorderBrush="#1E90FF"
                                        BorderThickness="1"
                                        Background="White">
                                    <Calendar x:Name="PART_Calendar"
                                              IsTodayHighlighted="True"
                                              DisplayMode="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=DatePicker}}"
                                              SelectedDate="{Binding SelectedDate, RelativeSource={RelativeSource AncestorType=DatePicker}, Mode=TwoWay}"
                                              DisplayDate="{Binding DisplayDate, RelativeSource={RelativeSource AncestorType=DatePicker}, Mode=TwoWay}"
                                              Style="{x:Null}"/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- Открытие по кнопке - стандартный триггер -->
                            <Trigger SourceName="PART_Button" Property="IsPressed" Value="True">
                                <Setter Property="IsDropDownOpen" Value="True" />
                            </Trigger>
                            <!-- Открытие по фокусу поля ввода -->
                            <Trigger SourceName="PART_TextBox" Property="IsKeyboardFocused" Value="True">
                                <Setter Property="IsDropDownOpen" Value="True"/>
                            </Trigger>
                            <!-- Подсветка обводки при фокусе -->
                            <Trigger SourceName="PART_TextBox" Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#1E90FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Стиль для текстбокса внутри DatePicker -->
        <Style TargetType="DatePickerTextBox">
            <Setter Property="Padding" Value="8,2,36,2"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Border Background="White" CornerRadius="10" Padding="20" Margin="10">
            <StackPanel>
                <!-- Шапка с кнопкой назад и заголовком по центру -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="← Назад"
                            Style="{StaticResource ClassicButtonStyle}"
                            Click="BackButton_Click"
                            HorizontalAlignment="Left"
                            Grid.Column="0" Width="94"/>
                    <TextBlock Text="Отчет по бронированиям"
                               Grid.Column="1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#1E90FF"/>
                    <TextBlock Grid.Column="2"/>
                </Grid>
                <!-- Фильтр по датам и кнопки справа -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Период с:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="15" FontWeight="SemiBold" Grid.Column="0"/>
                    <DatePicker x:Name="FromDatePicker"
                                Grid.Column="1"
                                Style="{StaticResource RoundedDatePickerStyle}"
                                VerticalAlignment="Center"
                                Margin="0"/>
                    <TextBlock Text="по:" VerticalAlignment="Center" Margin="8,0,6,0" FontSize="15" FontWeight="SemiBold" Grid.Column="2"/>
                    <DatePicker x:Name="ToDatePicker"
                                Grid.Column="3"
                                Style="{StaticResource RoundedDatePickerStyle}"
                                VerticalAlignment="Center"
                                Margin="0"/>
                    <Button Content="Показать отчет"
                            Style="{StaticResource ClassicButtonStyle}"
                            Click="GenerateReportButton_Click"
                            Grid.Column="5"
                            Margin="10,0,10,0"/>
                    <Button Content="Экспорт в CSV"
                            Style="{StaticResource ExportButtonStyle}"
                            Click="ExportButton_Click"
                            Grid.Column="6"/>
                </Grid>
                <!-- Список отчёта -->
                <ListView x:Name="ReportListView"
                          Margin="0,10,0,0"
                          VerticalAlignment="Stretch"
                          HorizontalAlignment="Stretch">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel VerticalAlignment="Stretch"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FFFFFF" Margin="5" Padding="10" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding BookingId}" Grid.Column="0" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding PropertyName}" Grid.Column="1" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ClientName}" Grid.Column="2" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ManagerName}" Grid.Column="3" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding StartDate, StringFormat='dd.MM.yyyy'}" Grid.Column="4" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding EndDate, StringFormat='dd.MM.yyyy'}" Grid.Column="5" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Status}" Grid.Column="6" FontSize="13" Foreground="#1E90FF" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Price, StringFormat=N2}" Grid.Column="7" FontSize="13" FontWeight="Bold" Foreground="#2D8C2D" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>
    </Grid>
</Window>